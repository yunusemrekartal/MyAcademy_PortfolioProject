@model About
@{
    ViewData["Title"] = "Yeni Hakkımda Bilgisi Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}
<form method="post">
    <label asp-for="Title">Başlık</label>
    <input class="form-control" asp-for="Title" type="text" required/>
    <br />
    <label asp-for="Description">Açıklama</label>
    <textarea class="form-control" asp-for="Description" required></textarea>
    <br />
    <label asp-for="ImageUrl">Görsel Url</label>
    <input class="form-control" type="text" asp-for="ImageUrl" required />
    <button class="btn btn-outline-dark">Kaydet</button>
</form>