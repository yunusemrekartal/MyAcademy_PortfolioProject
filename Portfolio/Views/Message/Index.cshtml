@model List<UserMessage>
@{
    Layout="~/Views/AdminLayout/Layout.cshtml";
    ViewData["Title"] = "Gelen Mesajlar";
    int counter = 0;
}
<!-- Filtreleme Butonları -->
<div class="mb-3 d-flex gap-2">
    <a href="/Message/Index" class="btn btn-outline-secondary btn-sm">Tümü</a>
    <a href="/Message/Index?filter=read" class="btn btn-outline-success btn-sm">Okunanlar</a>
    <a href="/Message/Index?filter=unread" class="btn btn-outline-warning btn-sm">Okunmayanlar</a>
</div>
<table class="table table-bordered table-hover align-middle">
    <thead>
        <tr>
            <th>No</th>
            <th>Durum</th>
            <th>Ad Soyad</th>
            <th>E Posta</th>
            <th>Mesaj</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var msg in Model)
        {
            var _msg = msg.MessageBody.Length > 50 ? msg.MessageBody.Substring(0, 50) + "..." : msg.MessageBody;
            counter++;
            var _IsRead = msg.IsRead == true ? "Okundu" : "Okunmadı";
            <tr>
                <td>@counter</td>
                <td>@_IsRead</td>
                <td>@msg.Name</td>
                <td>@msg.Email</td>
                <td>@_msg</td>
                <td>
                    <div class="d-inline-flex justify-content-center gap-3">
                        <a class="d-inline-flex justify-content-center align-items-center" href="/Message/MessageDetails/@msg.Id">
                            <span class="material-symbols-outlined">
                                visibility
                            </span>
                            <span>Detay</span>
                        </a>
                        <a href="/Message/DeleteMessage/@msg.Id" class="text-danger d-inline-flex">
                            <span class="material-symbols-outlined">
                                delete
                            </span>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
