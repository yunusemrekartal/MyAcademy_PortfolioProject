@model UserMessage
@{
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    ViewData["Title"] = "Mesaj Detayı";
}
<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <!-- Başlık ve Geri Dön Butonu -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <h4 class="mb-0 text-primary">
                    <span class="material-symbols-outlined align-middle me-1">mail</span>
                    Mesaj Detayı
                </h4>
                <a href="/Message/Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                    <span class="material-symbols-outlined fs-6">arrow_back</span> Geri Dön
                </a>
            </div>

            <!-- İlk Satır: Gönderen Bilgisi -->
            <div class="mb-3">
                <span class="text-muted fw-semibold">Gönderen:</span>
                <span class="text-dark ms-2">@Model.Name</span>
            </div>

            <!-- Bir Alt Satır: Mesaj İçeriği -->
            <div class="mt-4">
                <label class="text-muted fw-semibold d-block mb-2">Mesaj İçeriği:</label>
                <div class="p-3 bg-light rounded-3 border">
                    <p class="mb-0 text-secondary" style="white-space: pre-line;">@Model.MessageBody</p>
                </div>
            </div>

        </div>
    </div>
</div>
