@model Project
@{
    ViewData["Title"] = "Proje Oluştur";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}
<form method="post">
    <label>Proje Adı</label>
    <input class="form-control" type="text" asp-for="Name" />
    <span class="text-danger" asp-validation-for="Name"></span>
    <br />
    <label>Resim Url</label>
    <input class="form-control" type="text" asp-for="ImageUrl" />
    <span class="text-danger" asp-validation-for="ImageUrl"></span>
    <br />
    <label>Proje Açıklaması</label>
    <textarea class="form-control" type="text" asp-for="Description" rows="3"></textarea>
    <span class="text-danger" asp-validation-for="Description"></span>
    <br />
    <label>Github URL</label>
    <input class="form-control" type="url" asp-for="GithubUrl" />
    <span class="text-danger" asp-validation-for="GithubUrl"></span>
    <br />
    <button class="btn btn-outline-dark">Oluştur</button>
</form>