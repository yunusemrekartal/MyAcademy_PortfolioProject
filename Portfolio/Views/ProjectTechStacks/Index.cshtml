@model List<ProjectTechStack>
@{
    ViewData["Title"] = "Proje Teknolojileri";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
    List<ProjectTechStack> ptsl;
}
<table class="table table-hover table-bordered">
    <tr>
        <th>ID</th>
        <th>Proje</th>
        <th>Teknolojiler</th>
    </tr>
    @foreach (var ptc in Model)
    {
        count++;
        <tr>
            <td>@count</td>
            <td>@ptc.Project.Name</td>
            <td>@ptc.TechStack.Name</td>
        </tr>
    }
</table>
<a class="btn btn-outline-dark" href="/ProjectTechStacks/Create">Yeni Ekle</a>