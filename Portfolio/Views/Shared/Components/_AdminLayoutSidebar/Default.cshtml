@*
    Admin Layout Sidebar
*@
@{
}
<aside class="w-sidebar-width h-screen fixed left-0 top-0 bg-surface-lowest border-r border-outline-variant flex flex-col py-lg z-50">
    <div class="px-md mb-xl">
        <h2 class="font-h2 text-h2 font-bold text-primary">Portfolio Admin Paneli</h2>
        <p class="text-on-surface-variant font-label-sm mt-xs">Yönetim Sayfası</p>
    </div>
    <nav class="flex-1 space-y-1">
        <!-- Kontrol Paneli -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/DashBoard/Index">
            <span class="material-symbols-outlined">add_chart</span>
            <span class="font-label-md text-label-md">Kontrol Paneli</span>
        </a>
        <!-- Banner -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Banner/Index">
            <span class="material-symbols-outlined">image_inset</span>
            <span class="font-label-md text-label-md">Banner</span>
        </a>
        <!-- Projelerim -->
        <a class="relative flex items-center gap-md px-md py-sm border-primary cursor-pointer active:opacity-80" href="/Project/Index">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">folder_open</span>
            <span class="font-label-md text-label-md">Projelerim</span>
        </a>
        <!-- Hakkımda -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/About/Index">
            <span class="material-symbols-outlined">category</span>
            <span class="font-label-md text-label-md">Hakkımda</span>
        </a>
        <!-- Deneyimlerim -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Experience/Index">
            <span class="material-symbols-outlined">work_history</span>
            <span class="font-label-md text-label-md">Deneyimlerim</span>
        </a>
        <!-- Eğitimlerim -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Education/Index">
            <span class="material-symbols-outlined">school</span>
            <span class="font-label-md text-label-md">Eğitimlerim</span>
        </a>
        <!-- Referanslarım -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Testimonial/Index">
            <span class="material-symbols-outlined">format_quote</span>
            <span class="font-label-md text-label-md">Referanslarım</span>
        </a>
        <!-- Hizmetlerim -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Service/Index">
            <span class="material-symbols-outlined"> construction </span>
            <span class="font-label-md text-label-md">Hizmetlerim</span>
        </a>
        <!-- Messages -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Message/Index">
            <span class="material-symbols-outlined">mail</span>
            <span class="font-label-md text-label-md">Gelen Mesajlar</span>
        </a>
        @* frontend *@
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Default/Index">
            <span class="material-symbols-outlined">open_in_new</span>
            <span class="font-label-md text-label-md">Ön Yüze Git</span>
        </a>
        @* Sinout *@
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Auth/Logout">
            <span class="material-symbols-outlined">logout</span>
            <span class="font-label-md text-label-md">Çıkış Yap</span>
        </a>
    </nav>
    <div class="mt-auto px-md flex items-center gap-md pt-lg border-t border-outline-variant">
        <img class="w-10 h-10 rounded-full object-cover" data-alt="A professional headshot of a senior project manager with a friendly expression, wearing a navy blue blazer against a neutral office background. The lighting is soft and professional, emphasizing a modern corporate aesthetic with high-quality, high-key values." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDlqBWu1p3aEq67qLFKu3y0UlRSj2DnWM__vm_crDnbFt0J1ysDUDdO844jg0nfKyChHiwtprZpN7CA3NUWKdHRFl9P8J1GJ028acIMqkkHcyPX3vP-AB-NprsvMmxoHSenYYR-g8W4k6DVuPAXSbNCH4DrEV4_2_GzRs1fGTBkJVgBqXOhs8AL0fYxwnpir9XR3RDD69DW37S4km1I3hj57im8Qkw3l9z73SC8C7_IOQ71vqx5-6vGnu6WDoQUdm9B06QEUJwZHz3V" />
        <div>
            <p class="font-label-md text-label-md font-bold text-on-surface">@ViewBag.fullName</p>
            <p class="text-[10px] text-on-surface-variant uppercase tracking-wider font-semibold">Admin</p>
        </div>
    </div>
</aside>
