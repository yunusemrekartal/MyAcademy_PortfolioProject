@model List<ContactInfo>
@*
    Default Contact Info
*@

@foreach(var item in Model)
{
    <div>
        <h2 class="font-headline-md text-headline-md text-on-background mb-4">Gelin, birlikte bir şeyler inşa edelim.</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mb-stack-lg max-w-md">Şu anda serbest (freelance) çalışmaya ve yeni fırsatlara açığım. Benimle iletişime geçin; bir sonraki projenizi konuşalım.</p>
        <div class="space-y-6">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-surface-variant flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">mail</span>
                </div>
                <div>
                    <h4 class="font-label-sm text-label-sm text-on-surface-variant">Email</h4>
                    <p class="font-body-md text-body-md text-on-background">@item.Email</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-surface-variant flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">location_on</span>
                </div>
                <div>
                    <h4 class="font-label-sm text-label-sm text-on-surface-variant">Lokasyon</h4>
                    <p class="font-body-md text-body-md text-on-background">@item.Address</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-surface-variant flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">link</span>
                </div>
                <div>
                    <h4 class="font-label-sm text-label-sm text-on-surface-variant">Sosyal Medya</h4>
                    <div class="flex gap-4 mt-1">
                        <a class="text-on-background hover:text-primary transition-colors" href="@item.LinkedinUrl">Linkdin</a>
                        <a class="text-on-background hover:text-primary transition-colors" href="@item.GithubUrl">GitHub</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}