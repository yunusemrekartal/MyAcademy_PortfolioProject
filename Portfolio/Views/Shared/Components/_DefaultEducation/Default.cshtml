@model List<Education>
@{
    Layout = null;
}
<!-- Education -->
<div>
    <h3 class="font-body-lg text-body-lg font-semibold text-on-background mb-stack-md flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">school</span> Eğitim Bilgilerim
    </h3>
    <div class="relative border-l border-outline-variant/30 pl-6 ml-3 space-y-stack-lg">
        @foreach (var edu in Model)
        {
            if (edu.GraduationYear == null)
            {
                <div class="relative">
                    <span class="absolute -left-[31px] top-1 w-4 h-4 rounded-full bg-primary ring-4 ring-background"></span>
                    <h4 class="font-body-lg text-body-lg text-on-background font-semibold">@edu.Department</h4>
                    <p class="font-label-sm text-label-sm text-primary mb-2">@edu.SchoolName | @edu.StartYear - Halen |GANO:@edu.GPA</p>
                    <p class="font-body-md text-body-md text-on-surface-variant">@edu.Description</p>
                </div>
            }
            else
            {
                <div class="relative">
                    <span class="absolute -left-[31px] top-1 w-4 h-4 rounded-full bg-primary ring-4 ring-background"></span>
                    <h4 class="font-body-lg text-body-lg text-on-background font-semibold">@edu.Department</h4>
                    <p class="font-label-sm text-label-sm text-primary mb-2">@edu.SchoolName | @edu.StartYear - @edu.GraduationYear |GANO:@edu.GPA</p>
                    <p class="font-body-md text-body-md text-on-surface-variant">@edu.Description</p>
                </div>
            }
        }
    </div>
</div>